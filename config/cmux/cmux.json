{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "shortcuts": {
    "bindings": {
      // Leader key matches tmux's prefix (default C-b, unchanged in
      // config/tmux/tmux.conf). Chords below mirror that file's pane
      // split / navigate / zoom / copy-mode bindings.
      "splitRight": ["ctrl+b", "v"],
      "splitDown": ["ctrl+b", "s"],
      "focusLeft": ["ctrl+b", "h"],
      "focusDown": ["ctrl+b", "j"],
      "focusUp": ["ctrl+b", "k"],
      "focusRight": ["ctrl+b", "l"],
      "toggleSplitZoom": ["ctrl+b", "z"],
      "toggleTerminalCopyMode": ["ctrl+b", "["],
      // cmux has no dedicated "kill this split" action; closeTab closes the
      // active surface, which is what tmux's `bind-key x kill-pane` does in
      // practice for a single-tab pane.
      "closeTab": ["ctrl+b", "x"],
      "newSurface": ["ctrl+b", "c"],
      // tmux's `bind-key 1..9 select-window -t N`; cmux's per-pane tab
      // equivalent is "surfaces". Chord prefix + bare digit selects by index.
      "selectSurfaceByNumber": ["ctrl+b", "1"]
    }
  }

}
